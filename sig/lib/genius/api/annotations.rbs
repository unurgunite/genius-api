module Genius
  module Annotations
    def self.annotations: (id: untyped, action: untyped, token: String?, http_verb: String, options: Hash[untyped, untyped]) -> (Hash[untyped, untyped] | nil)

    private

    def self.request: (id: untyped, action: untyped, token: String?, http_verb: String, options: Hash[untyped, untyped]) -> untyped

    def self.put_request: (id: untyped, action: untyped, token: String?, options: Hash[untyped, untyped]) -> untyped

    def self.post_payload: (?options: Hash[untyped, untyped]) -> String
  end
end
